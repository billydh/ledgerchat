# Copy to .env and fill in. Loaded by every script via --env-file.
# Never commit .env. Everything here is optional: the web app can also be
# configured from its Settings page, which writes model-settings.json next to
# the database.

# --- database -------------------------------------------------------------
# Default: the per-user data directory for the platform, outside the repo:
#   macOS    ~/Library/Application Support/ledgerchat/ledgerchat.db
#   Linux    $XDG_DATA_HOME/ledgerchat/ledgerchat.db (or ~/.local/share/...)
#   Windows  %APPDATA%\ledgerchat\ledgerchat.db
DB_PATH=

# --- server ---------------------------------------------------------------
# Default: 3000. The server always binds to 127.0.0.1.
PORT=

# --- local model ----------------------------------------------------------
# Any server with an OpenAI-compatible /v1/chat/completions endpoint that
# supports tool calling: Ollama (http://localhost:11434), oMLX
# (http://localhost:8000), LM Studio, llama.cpp, vLLM. It must run on this
# machine: only localhost, 127.0.0.1 and [::1] are accepted.
# Default: http://localhost:8000
LOCAL_LLM_BASE_URL=
# The model id exactly as GET /v1/models lists it, e.g. qwen3:32b
LOCAL_LLM_MODEL=
# Sent as a bearer token; most local servers ignore it. Default: local
LOCAL_LLM_API_KEY=
# false sends enable_thinking=false so hybrid reasoning models (Qwen3) answer
# directly instead of spending the whole output budget on reasoning.
LOCAL_LLM_THINKING=false
# true probes the endpoint once per process for streaming, native structured
# output and forced tool choice instead of using conservative defaults.
LOCAL_LLM_PROBE=false
# Output cap per request. Default: 8192. Thinking models spend this on
# reasoning as well as the reply.
LLM_MAX_TOKENS=
